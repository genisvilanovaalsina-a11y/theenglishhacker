# Stripe Checkout URLs — paste your Payment Link URLs from Stripe Dashboard
STRIPE_B2_URL=https://buy.stripe.com/your_b2_link
STRIPE_C1_URL=https://buy.stripe.com/your_c1_link

# Formspree endpoint ID — create a free form at formspree.io and paste the ID here
PUBLIC_FORMSPREE_ID=your_formspree_form_id
