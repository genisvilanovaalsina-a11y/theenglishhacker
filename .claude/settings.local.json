{
  "permissions": {
    "allow": [
      "PowerShell(npm *)",
      "PowerShell(npm create *)",
      "PowerShell(Write-Host \"Contingut de bizarre-bar:\"; \\(Get-ChildItem \"bizarre-bar\" -Force\\).Name -join \", \")",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(\\(Get-ChildItem \"bizarre-bar\" -Force -ErrorAction SilentlyContinue\\).Name -join \", \"; Write-Host \"---\"; Write-Host \"node_modules exists at root: $\\([System.IO.Directory]::Exists\\('node_modules'\\)\\)\")",
      "PowerShell(npx astro add tailwind react --yes 2>&1)",
      "PowerShell(node -e \"const p = require\\('./package.json'\\); console.log\\(JSON.stringify\\(p.dependencies, null, 2\\)\\)\")",
      "PowerShell(Test-Path \"node_modules\\\\astro\\\\dist\\\\config.js\"; Test-Path \"node_modules\\\\astro\\\\config.js\"; \\(Get-ChildItem \"node_modules\\\\astro\" -Force | Select-Object Name -First 10\\).Name -join \", \")",
      "PowerShell(npx --no astro add tailwind react --yes 2>&1)",
      "PowerShell(\\(Get-ChildItem \"src\" -Recurse -Force\\).FullName -replace [regex]::Escape\\(\\(Get-Location\\).Path + \"\\\\\"\\), \"\" | Sort-Object)",
      "PowerShell(git *)",
      "PowerShell(Test-Path *)",
      "PowerShell(winget *)",
      "PowerShell(Start-Sleep -Seconds 60; $env:PATH = $env:PATH + \";C:\\\\Program Files\\\\Git\\\\bin\"; git --version 2>&1)"
    ]
  }
}
