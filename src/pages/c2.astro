---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/waitlist/WaitlistForm.astro';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout
  title="C2 Proficiency — Coming Soon | The English Hacker"
  description="Cambridge C2 Proficiency practice is coming soon. Join the waitlist and get 40% off at launch."
>
  <header class="border-b border-hacker-border px-6 py-4 flex justify-between items-center">
    <a href="/" class="text-hacker-green font-bold text-sm">&gt;_ TheEnglishHacker</a>
  </header>

  <main class="max-w-2xl mx-auto px-6 py-16 space-y-10">
    <div>
      <div class="text-xs text-hacker-dim mb-4">[ STATUS: <span class="text-hacker-amber">BUILDING</span> ]</div>
      <h1 class="text-3xl font-bold mb-3">C2 Proficiency — Coming Soon</h1>
      <p class="text-sm text-hacker-dim leading-relaxed">
        Cambridge C2 Proficiency content is currently in development. Join the waitlist
        and we'll notify you the moment it goes live — with an exclusive 40% discount.
      </p>
    </div>

    <WaitlistForm level="C2 Proficiency" />

    <div class="text-xs text-hacker-dim">
      <a href="/" class="text-hacker-green hover:text-hacker-green-dim transition-colors">&lt; Back to all levels</a>
    </div>
  </main>

  <Footer />
</BaseLayout>
