---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import MiniQuiz from '../../../../components/practice/MiniQuiz';
import type { QuizQuestion } from '../../../../components/practice/MiniQuiz';

const unlockUrl = import.meta.env.STRIPE_C1_URL ?? '/unlock';

const quizQuestions: QuizQuestion[] = [
  {
    id: 1,
    sentence: 'Original: "I had only just sat down when the phone rang."\nKey word: SOONER\n\nNo ___ than the phone rang.',
    options: [
      { key: 'A', value: 'sooner had I sat down' },
      { key: 'B', value: 'sooner I had sat down' },
      { key: 'C', value: 'sooner did I sit down' },
      { key: 'D', value: 'sooner I sat down' },
    ],
    answer: 'A',
    explanation: '"No sooner had [subject] [past participle]..." is the inversion structure. When a negative adverbial opens a sentence, auxiliary + subject inverts ("had I" not "I had"). "No sooner did I sit down" would require "than" + past simple, but the past perfect is needed here to maintain the sequence of events. Option B lacks the inversion; D and B both omit it.',
    gapType: 'inversion — no sooner',
  },
  {
    id: 2,
    sentence: 'Original: "People believe that the painting was created by Vermeer."\nKey word: THOUGHT\n\nThe painting ___.',
    options: [
      { key: 'A', value: 'is thought to have been created by Vermeer' },
      { key: 'B', value: 'is thought to be created by Vermeer' },
      { key: 'C', value: 'was thought to have created by Vermeer' },
      { key: 'D', value: 'is thought that Vermeer created' },
    ],
    answer: 'A',
    explanation: 'Passive reporting structure: "is thought to have been [past participle]". The original says the painting WAS created (past) — so the passive infinitive must be perfect ("to have been created"), not simple ("to be created"). Option B uses simple passive infinitive, which would imply present/future creation. Option C wrongly uses active perfect infinitive.',
    gapType: 'passive reporting structure',
  },
  {
    id: 3,
    sentence: 'Original: "She succeeded only because her colleagues helped her."\nKey word: NOT\n\n___ for her colleagues\' help, she would not have succeeded.',
    options: [
      { key: 'A', value: 'Had it been' },
      { key: 'B', value: 'Were it not' },
      { key: 'C', value: 'Had it not been' },
      { key: 'D', value: 'It was not' },
    ],
    answer: 'C',
    explanation: '"Had it not been for..." is the inverted form of "If it had not been for..." — a third conditional expressing a past hypothetical. "Were it not for..." is also an inverted conditional but refers to present/general conditions, not past. The original sentence is clearly past ("succeeded... helped"), so the past form "had it not been" is required.',
    gapType: 'inverted conditional — past',
  },
  {
    id: 4,
    sentence: 'Original: "The government announced that it would reduce taxes."\nKey word: ANNOUNCEMENT\n\n___ taxes was welcomed by business leaders.',
    options: [
      { key: 'A', value: "The government's announcement to reduce" },
      { key: 'B', value: "The government's announcement of reducing" },
      { key: 'C', value: "The government's announcement of a reduction in" },
      { key: 'D', value: "The government's announcement for reducing" },
    ],
    answer: 'C',
    explanation: 'Nominalisation: "announcement" requires a specific prepositional structure. "Announcement of a reduction in" correctly nominalises "reduce taxes" → "a reduction in taxes". "Announcement to reduce" uses infinitive (only valid with verbs like "decision", "plan", "intention"). "Announcement of reducing" uses gerund after "of" — grammatically possible but less formal than full nominalisation.',
    gapType: 'nominalisation',
  },
  {
    id: 5,
    sentence: 'Original: "I deeply regret not applying for that position when I had the chance."\nKey word: WISHES\n\nShe ___ for that position when she had the chance.',
    options: [
      { key: 'A', value: 'wishes she applied' },
      { key: 'B', value: 'wishes she had applied' },
      { key: 'C', value: 'wishes she would have applied' },
      { key: 'D', value: 'wishes she were applying' },
    ],
    answer: 'B',
    explanation: '"Wish + past perfect" expresses regret about a past situation that cannot be changed. "Wishes she applied" (simple past after wish) expresses a present desire for change, not past regret. "Wishes she would have applied" is non-standard — "would have" doesn\'t follow "wish" for past regret. The key signal is "when she had the chance" — a completed past opportunity.',
    gapType: 'wish + past perfect',
  },
];

const schemaLearningResource = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  "name": "C1 Advanced Key Word Transformations (Part 4): Inversion, Cleft Sentences and Complex Conditionals",
  "description": "Master C1 Advanced Key Word Transformations with a focus on the three structures Cambridge introduces at C1 that are absent at B2: inversion, cleft sentences, and inverted conditionals.",
  "url": "https://theenglishhacker.com/practice/c1/use-of-english/part-4",
  "educationalLevel": "C1",
  "learningResourceType": ["Guide", "Practice"],
  "teaches": "Cambridge C1 Advanced Use of English Part 4 — Key Word Transformations",
  "inLanguage": "en",
  "provider": { "@type": "Organization", "name": "TheEnglishHacker", "url": "https://theenglishhacker.com" }
};

const schemaBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://theenglishhacker.com" },
    { "@type": "ListItem", "position": 2, "name": "C1 Advanced", "item": "https://theenglishhacker.com/c1" },
    { "@type": "ListItem", "position": 3, "name": "Use of English", "item": "https://theenglishhacker.com/c1" },
    { "@type": "ListItem", "position": 4, "name": "Part 4 — Key Word Transformations", "item": "https://theenglishhacker.com/practice/c1/use-of-english/part-4" }
  ]
};

const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What structures does C1 Part 4 test that B2 Part 4 doesn't?",
      "acceptedAnswer": { "@type": "Answer", "text": "Three major structure types appear regularly at C1 but are essentially absent at B2: (1) inversion after negative adverbials (No sooner had..., Not until..., Hardly had..., Only then did...), (2) cleft sentences (It was...that..., What impressed me was...), and (3) inverted conditionals (Were it not for..., Had it not been for..., Should you need...). Mastering these three categories covers the majority of C1-exclusive content in Part 4." }
    },
    {
      "@type": "Question",
      "name": "How many words are allowed in C1 Part 4?",
      "acceptedAnswer": { "@type": "Answer", "text": "Between 3 and 8 words, including the key word. This is wider than B2 (2–5 words) and reflects the more complex structures tested — inversions and cleft sentences require more words to construct correctly. Contractions count as two words. The wider limit doesn't mean you should use 8 words by default — only write as many as the correct structure requires." }
    },
    {
      "@type": "Question",
      "name": "Does C1 Part 4 use partial marking?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, identical to B2: 2 marks per question, 1 mark for each half of the transformation assessed independently. At C1, the two halves often correspond to: the inversion/cleft structure itself (primary transformation) and the correct tense or preposition within that structure (secondary detail). A correctly inverted sentence with the wrong tense still earns 1 mark." }
    },
    {
      "@type": "Question",
      "name": "Are inversions always tested in C1 Part 4?",
      "acceptedAnswer": { "@type": "Answer", "text": "Not always, but they appear in the majority of C1 Part 4 papers — typically 1–3 questions out of 6. The most frequent inversion triggers are: No sooner, Not until, Hardly/Scarcely, Only then, Never before, Not only...but also, and Rarely. If you see any of these as the key word or in the opening of the second sentence, an inversion structure is required." }
    },
    {
      "@type": "Question",
      "name": "What is the best way to practise C1 Key Word Transformations?",
      "acceptedAnswer": { "@type": "Answer", "text": "Work through authentic Cambridge C1 past papers systematically, noting which structure each key word triggers. For inversions, practise writing them from scratch — not just recognising them — because the auxiliary-subject switch must become automatic. For cleft sentences and nominalisations, practise converting simple active sentences into formal written equivalents. The full exam pack at TheEnglishHacker includes 5 complete C1 exams with Part 4 answer keys and transformation-by-transformation analysis." }
    }
  ]
};
---

<BaseLayout
  title="C1 Advanced Key Word Transformations (Part 4): Inversions, Cleft Sentences & Complex Conditionals"
  description="C1 Part 4 introduces three structures that simply don't exist at B2: inversion, cleft sentences, and inverted conditionals. Learn each pattern, see annotated examples, and practise with 5 C1-level questions."
  ogImage="/logo-og.svg"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaLearningResource)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} />

  <header class="border-b border-hacker-border px-4 py-3 text-xs text-hacker-dim overflow-x-auto">
    <div class="flex items-center gap-4 min-w-max">
      <a href="/" class="text-hacker-green hover:text-hacker-green-dim transition-colors">&gt;_ TheEnglishHacker</a>
      <span>/</span>
      <a href="/c1" class="hover:text-hacker-green transition-colors">[ C1_ADVANCED ]</a>
      <span>/</span>
      <span class="text-hacker-text">Use of English · Part 4</span>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 py-12 space-y-16">

    <!-- HERO -->
    <section class="space-y-5">
      <div class="text-xs text-hacker-dim">// PRACTICE_GUIDE · C1_ADVANCED · USE_OF_ENGLISH</div>
      <h1 class="text-3xl font-bold text-hacker-text leading-tight">
        Use of English — Part 4<br/>
        <span class="text-hacker-green">Key Word Transformations</span>
      </h1>
      <div class="flex flex-wrap gap-4 text-xs font-mono">
        <span class="border border-hacker-border px-3 py-1 text-hacker-dim">6 questions</span>
        <span class="border border-hacker-border px-3 py-1 text-hacker-dim">12 marks</span>
        <span class="border border-hacker-border px-3 py-1 text-hacker-dim">3–8 words per gap</span>
        <span class="border border-hacker-green px-3 py-1 text-hacker-green">Difficulty: ★★★★★</span>
        <span class="border border-hacker-border px-3 py-1 text-hacker-dim">~8 min read</span>
      </div>
      <p class="text-sm text-hacker-dim leading-relaxed">
        The same format as B2 Part 4 — but with three additional structure categories that are entirely absent at B2 level. Inversions, cleft sentences, and inverted conditionals are the wall that separates B2 scorers from C1 scorers on this part.
      </p>
    </section>

    <!-- WHO THIS IS FOR -->
    <section class="border border-hacker-border p-6 space-y-3">
      <div class="text-xs text-hacker-dim">// WHO_THIS_IS_FOR</div>
      <p class="text-sm text-hacker-text leading-relaxed">
        If you scored consistently on B2 Part 4 but C1 Part 4 is exposing gaps — particularly on questions where the second sentence starts with "No sooner...", "Not until...", or "It was...that..." — this guide is for you. These structures are not intuitively learnable through exposure alone. They require deliberate study of the <strong class="text-hacker-green">exact pattern</strong>, not just the meaning.
      </p>
    </section>

    <!-- WHAT IS THIS PART -->
    <section class="space-y-6">
      <div class="text-xs text-hacker-dim">// WHAT_IS_THIS_PART</div>
      <h2 class="text-xl font-bold text-hacker-text">The B2→C1 jump in Part 4</h2>
      <p class="text-sm text-hacker-dim leading-relaxed">
        The format is identical to B2: a complete sentence, a key word in capitals, and an incomplete second sentence to complete (2 marks, partial marking available). The word limit widens from 2–5 words at B2 to <strong class="text-hacker-text">3–8 words</strong> at C1 — reflecting the longer structures required.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {[
          ['Questions', '6'],
          ['Marks', '12 (2 per Q)'],
          ['Words per gap', '3–8 incl. key word'],
          ['New at C1', '3 structure types'],
        ].map(([label, value]) => (
          <div class="border border-hacker-border p-3 space-y-1">
            <div class="text-xs text-hacker-dim">{label}</div>
            <div class="text-sm font-bold text-hacker-green">{value}</div>
          </div>
        ))}
      </div>
      <div class="border border-hacker-amber/40 p-5 space-y-3">
        <div class="text-xs text-hacker-amber font-bold">// B2 → C1 STRUCTURAL JUMP</div>
        <p class="text-xs text-hacker-dim leading-relaxed">At B2, every transformation operates within the standard subject-verb-object order of English. At C1, Cambridge introduces three structure types that deliberately invert or restructure that order — creating patterns that most speakers have never consciously produced in writing. These cannot be guessed from meaning. They must be learnt as templates.</p>
      </div>
    </section>

    <!-- THE 3 C1-EXCLUSIVE STRUCTURES -->
    <section class="space-y-6">
      <div class="text-xs text-hacker-dim">// C1_EXCLUSIVE_STRUCTURES</div>
      <h2 class="text-xl font-bold text-hacker-text">The 3 structures Cambridge introduces at C1</h2>

      <!-- INVERSION -->
      <div class="border border-hacker-border p-5 space-y-4">
        <div class="text-xs text-hacker-green font-bold">STRUCTURE_01 · INVERSION AFTER NEGATIVE ADVERBIALS</div>
        <p class="text-xs text-hacker-dim leading-relaxed">When a sentence opens with a negative or restrictive adverbial expression, the auxiliary verb inverts with the subject — creating the same word order as a question. Cambridge tests this repeatedly because it's a hallmark of formal written English that most candidates have never produced.</p>
        <div class="space-y-2 font-mono text-xs border-t border-hacker-border pt-3">
          <div class="text-hacker-dim">Pattern: [Negative adverbial] + [auxiliary] + [subject] + [rest]</div>
          {[
            ['No sooner', 'No sooner had I arrived than it started raining.'],
            ['Not until', 'Not until the results were published did she relax.'],
            ['Hardly / Scarcely', 'Hardly had she spoken when he interrupted.'],
            ['Only then', 'Only then did I realise how serious it was.'],
            ['Never before', 'Never before had the committee faced such a challenge.'],
            ['Not only', 'Not only did she pass, but she also came top.'],
            ['Rarely', 'Rarely does such an opportunity present itself.'],
          ].map(([trigger, example]) => (
            <div class="border-b border-hacker-border/30 pb-2">
              <span class="text-hacker-green">{trigger}: </span>
              <span class="text-hacker-text">{example}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- CLEFT SENTENCES -->
      <div class="border border-hacker-border p-5 space-y-4">
        <div class="text-xs text-hacker-green font-bold">STRUCTURE_02 · CLEFT SENTENCES</div>
        <p class="text-xs text-hacker-dim leading-relaxed">Cleft sentences reorganise a simple sentence to place emphasis on a specific element. Cambridge uses them to test whether candidates can restructure a neutral sentence into a more emphatic, formal equivalent. Two types appear regularly:</p>
        <div class="space-y-3 font-mono text-xs border-t border-hacker-border pt-3">
          <div>
            <div class="text-hacker-green mb-1">IT-cleft: "It was [emphasised element] that..."</div>
            <div class="text-hacker-dim">Original: "The funding cut caused the programme to fail."</div>
            <div class="text-hacker-text">Cleft: "It was the funding cut that caused the programme to fail."</div>
          </div>
          <div>
            <div class="text-hacker-green mb-1">WH-cleft: "What [subject] [verb] was..."</div>
            <div class="text-hacker-dim">Original: "Her attention to detail impressed everyone."</div>
            <div class="text-hacker-text">Cleft: "What impressed everyone was her attention to detail."</div>
          </div>
        </div>
      </div>

      <!-- INVERTED CONDITIONALS -->
      <div class="border border-hacker-border p-5 space-y-4">
        <div class="text-xs text-hacker-green font-bold">STRUCTURE_03 · INVERTED CONDITIONALS</div>
        <p class="text-xs text-hacker-dim leading-relaxed">Formal English can express conditional meaning without "if" by inverting the auxiliary and subject. Cambridge tests this as a transformation from standard "if" conditionals to their inverted equivalents — a pattern found in formal writing but almost never in speech.</p>
        <div class="space-y-3 font-mono text-xs border-t border-hacker-border pt-3">
          {[
            ['Present/future', '"If you need help..."', '"Should you need help..."'],
            ['Past (3rd conditional)', '"If I had known..."', '"Had I known..."'],
            ['Past negative', '"If it had not been for..."', '"Had it not been for..."'],
            ['Present negative', '"If it were not for..."', '"Were it not for..."'],
          ].map(([type, standard, inverted]) => (
            <div class="border-b border-hacker-border/30 pb-2">
              <div class="text-hacker-amber text-xs mb-1">{type}</div>
              <div class="text-hacker-dim">{standard}</div>
              <div class="text-hacker-green">→ {inverted}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STRATEGIES -->
    <section class="space-y-6">
      <div class="text-xs text-hacker-dim">// STRATEGIES</div>
      <h2 class="text-xl font-bold text-hacker-text">5 strategies for C1 Part 4</h2>
      <div class="space-y-5">
        <div class="border-l-2 border-hacker-green pl-5 space-y-2">
          <div class="text-xs text-hacker-dim">STRATEGY_01</div>
          <h3 class="text-sm font-bold text-hacker-text">Recognise the C1-trigger words immediately</h3>
          <p class="text-xs text-hacker-dim leading-relaxed">When you see SOONER, HARDLY, SCARCELY, RARELY, NEVER, or NOT in the key word — inversion is required. When you see IT or WHAT at the start of the second sentence — cleft structure is expected. When you see WERE, HAD, or SHOULD as the key word in a conditional context — inverted conditional. Training yourself to spot these triggers before engaging with the full sentence saves time and prevents guessing.</p>
        </div>
        <div class="border-l-2 border-hacker-green pl-5 space-y-2">
          <div class="text-xs text-hacker-dim">STRATEGY_02</div>
          <h3 class="text-sm font-bold text-hacker-text">Memorise inversion as a template, not a rule</h3>
          <p class="text-xs text-hacker-dim leading-relaxed">The inversion rule (negative adverbial → auxiliary before subject) is abstract. What works in the exam is having templates memorised: "No sooner had [S] [V-pp] than [S] [V-past]", "Not until [clause] did [S] [V]", "Hardly had [S] [V-pp] when [S] [V-past]". Write these out 10 times each until the auxiliary-subject switch is automatic. In the exam, you fill in the subject and verb from the original sentence.</p>
        </div>
        <div class="border-l-2 border-hacker-green pl-5 space-y-2">
          <div class="text-xs text-hacker-dim">STRATEGY_03</div>
          <h3 class="text-sm font-bold text-hacker-text">For passive reporting, match the tense of the original exactly</h3>
          <p class="text-xs text-hacker-dim leading-relaxed">"It is believed that...", "People think that...", "Experts consider that..." → passive reporting structures. The most common error: using simple passive infinitive ("is believed to create") when the past requires perfect passive infinitive ("is believed to have been created"). The rule: if the original sentence's verb is in the past, the passive infinitive must be perfect — "to have been [past participle]".</p>
        </div>
        <div class="border-l-2 border-hacker-green pl-5 space-y-2">
          <div class="text-xs text-hacker-dim">STRATEGY_04</div>
          <h3 class="text-sm font-bold text-hacker-text">For nominalisations, learn the correct preposition for each noun</h3>
          <p class="text-xs text-hacker-dim leading-relaxed">Nominalisation questions require converting a verb phrase into a noun phrase: "decided to cut" → "decision to cut" / "announced a reduction in" → "announcement of a reduction in". The danger zone is the preposition: "decision TO", "announcement OF", "increase IN", "reduction IN", "agreement ON". Cambridge gaps nominalisations at the preposition precisely because it's the element candidates haven't memorised.</p>
        </div>
        <div class="border-l-2 border-hacker-green pl-5 space-y-2">
          <div class="text-xs text-hacker-dim">STRATEGY_05</div>
          <h3 class="text-sm font-bold text-hacker-text">Always claim partial credit — never leave a question blank</h3>
          <p class="text-xs text-hacker-dim leading-relaxed">At C1, the difficulty of Part 4 means candidates often face questions they're genuinely uncertain about. The partial marking system (1 mark per correct half) means a reasonable attempt at a complex structure — even if the secondary detail is wrong — may still earn 1 mark. If you recognise that inversion is needed but can't recall the exact template, write the inversion you know best and complete the sentence meaningfully. Blank = 0. Reasonable attempt = potentially 1.</p>
        </div>
      </div>
    </section>

    <!-- COMMON MISTAKES -->
    <section class="space-y-6">
      <div class="text-xs text-hacker-dim">// COMMON_MISTAKES</div>
      <h2 class="text-xl font-bold text-hacker-text">3 mistakes on C1 Part 4</h2>
      <div class="space-y-4">
        {[
          {
            n: '01',
            title: 'Writing inversion without auxiliary-subject switch',
            body: 'The most frequent error on C1 inversion questions. Candidates understand that "No sooner" requires inversion but write "No sooner I had arrived" instead of "No sooner had I arrived". The auxiliary must precede the subject — exactly as in a question. This is a full-mark error if both halves are otherwise correct: the inversion itself earns the primary mark, but "I had" instead of "had I" may cost the secondary mark depending on the examiner\'s interpretation.',
          },
          {
            n: '02',
            title: 'Using simple passive infinitive for past events',
            body: '"It is reported that scientists discovered..." → "Scientists are reported to discover..." This is the most common error in passive reporting transformations. The discovery is past — "to discover" (simple passive infinitive) implies present or future. The correct structure is "Scientists are reported to have discovered..." (perfect passive infinitive). The temporal relationship between the reporting verb and the event must be preserved.',
          },
          {
            n: '03',
            title: 'Exceeding 8 words without noticing',
            body: 'The wider word limit at C1 (3–8 words vs 2–5 at B2) creates a false sense of security. Candidates who correctly identify a complex structure sometimes write 9 or 10 words, particularly on cleft sentence and nominalisation questions. Inversion templates are the most likely to exceed the limit because of their auxiliary-subject-verb-complement chain. Count words every single time — the limit is absolute.',
          },
        ].map(item => (
          <div class="border border-hacker-border p-5 grid grid-cols-[32px_1fr] gap-4">
            <div class="text-hacker-red font-bold text-sm font-mono">{item.n}</div>
            <div>
              <div class="text-sm font-bold text-hacker-text mb-2">{item.title}</div>
              <p class="text-xs text-hacker-dim leading-relaxed">{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- EXAMPLES -->
    <section class="space-y-6">
      <div class="text-xs text-hacker-dim">// REAL_FORMAT_EXAMPLES</div>
      <h2 class="text-xl font-bold text-hacker-text">6 annotated C1 examples</h2>
      <div class="space-y-5">
        {[
          {
            n: '01', kw: 'SOONER', type: 'INVERSION',
            s1: '"I had only just sat down when the phone rang."',
            s2: 'No ___ than the phone rang.',
            ans: 'sooner had I sat down',
            words: '5 words ✓',
            note: 'Auxiliary (had) precedes subject (I). Past perfect maintained from original.',
          },
          {
            n: '02', kw: 'THOUGHT', type: 'PASSIVE REPORTING',
            s1: '"People believe that the painting was created by Vermeer."',
            s2: 'The painting ___.',
            ans: 'is thought to have been created by Vermeer',
            words: '7 words ✓',
            note: 'Perfect passive infinitive required: "to have been created" because the creation is past relative to the reporting.',
          },
          {
            n: '03', kw: 'NOT', type: 'INVERTED CONDITIONAL',
            s1: '"She succeeded only because her colleagues helped her."',
            s2: '___ for her colleagues\' help, she would not have succeeded.',
            ans: 'Had it not been',
            words: '4 words ✓',
            note: 'Past inverted conditional: "Had it not been for..." = "If it had not been for...". "Were it not for" would imply present.',
          },
          {
            n: '04', kw: 'ANNOUNCEMENT', type: 'NOMINALISATION',
            s1: '"The government announced that it would reduce taxes."',
            s2: '___ taxes was welcomed by business leaders.',
            ans: "The government's announcement of a reduction in",
            words: '7 words ✓',
            note: 'Full nominalisation: "reduce taxes" → "a reduction in taxes". Preposition "of" required after "announcement".',
          },
          {
            n: '05', kw: 'WHAT', type: 'CLEFT SENTENCE',
            s1: '"Her calm under pressure impressed the entire panel."',
            s2: '___ the entire panel.',
            ans: 'What impressed',
            words: '2 words + continuation ✓',
            note: 'WH-cleft: "What [S] [V] was [emphasised element]". Emphasis shifts from subject to predicate.',
          },
          {
            n: '06', kw: 'WISHES', type: 'WISH + PAST PERFECT',
            s1: '"I deeply regret not applying for that position."',
            s2: 'She ___ for that position.',
            ans: 'wishes she had applied',
            words: '4 words ✓',
            note: 'Wish + past perfect for past regret. Simple past after wish ("wishes she applied") would express present desire, not past regret.',
          },
        ].map(ex => (
          <div class="border border-hacker-border p-5 space-y-3">
            <div class="flex flex-wrap gap-3 text-xs">
              <span class="text-hacker-dim">Example {ex.n}</span>
              <span class="text-hacker-green font-bold">[{ex.kw}]</span>
              <span class="text-hacker-green">[{ex.type}]</span>
            </div>
            <div class="font-mono text-xs space-y-1">
              <p class="text-hacker-dim">{ex.s1}</p>
              <p class="text-hacker-text">{ex.s2}</p>
            </div>
            <div class="border-t border-hacker-border pt-3 space-y-1">
              <p class="text-xs font-bold text-hacker-green">&gt;_ "{ex.ans}" — {ex.words}</p>
              <p class="text-xs text-hacker-dim">{ex.note}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- MINI QUIZ -->
    <section class="space-y-6">
      <div class="text-xs text-hacker-dim">// PRACTICE_QUIZ</div>
      <h2 class="text-xl font-bold text-hacker-text">Practice quiz — 5 C1-level transformations</h2>
      <p class="text-xs text-hacker-dim">Each question targets one of the C1-exclusive structures. Identify the structure type before selecting your answer.</p>
      <MiniQuiz client:load questions={quizQuestions} />
    </section>

    <!-- FAQ -->
    <section class="space-y-6">
      <div class="text-xs text-hacker-dim">// FAQ</div>
      <h2 class="text-xl font-bold text-hacker-text">Frequently asked questions</h2>
      <div class="space-y-4">
        {[
          { q: 'What structures does C1 Part 4 test that B2 Part 4 doesn\'t?', a: 'Three major types appear at C1 but not B2: (1) inversion after negative adverbials (No sooner had..., Not until..., Hardly had..., Rarely does...), (2) cleft sentences (It was...that..., What impressed me was...), and (3) inverted conditionals (Were it not for..., Had it not been for..., Should you need...). These three categories cover the majority of C1-exclusive content in Part 4.' },
          { q: 'How many words are allowed in C1 Part 4?', a: 'Between 3 and 8 words, including the key word. This is wider than B2 (2–5 words) and reflects the more complex structures tested. Contractions count as two words. Don\'t use 8 words by default — only write as many as the correct structure requires.' },
          { q: 'Does C1 Part 4 use partial marking?', a: 'Yes, identical to B2: 2 marks per question, 1 mark for each half of the transformation. At C1, the two halves often correspond to the inversion/cleft structure itself (primary) and the correct tense or preposition within that structure (secondary). A correctly inverted sentence with the wrong tense still earns 1 mark.' },
          { q: 'Are inversions always tested in C1 Part 4?', a: 'They appear in most papers — typically 1–3 questions out of 6. The most frequent triggers: No sooner, Not until, Hardly/Scarcely, Only then, Never before, Not only...but also, and Rarely. If you see any of these as the key word or in the opening of the second sentence, inversion is required.' },
          { q: 'What is the best way to practise C1 Key Word Transformations?', a: 'Work through authentic Cambridge C1 past papers systematically, noting which structure each key word triggers. For inversions, practise writing from scratch — not just recognising them — until the auxiliary-subject switch is automatic. The full exam pack includes 5 complete C1 exams with Part 4 answer keys and transformation-by-transformation analysis.' },
        ].map(item => (
          <details class="border border-hacker-border group">
            <summary class="px-5 py-4 text-sm font-bold text-hacker-text cursor-pointer flex items-center justify-between list-none hover:text-hacker-green transition-colors">
              <span>{item.q}</span>
              <span class="text-hacker-green font-mono text-xs ml-4 shrink-0 group-open:rotate-90 transition-transform">&gt;</span>
            </summary>
            <div class="px-5 pb-4 text-xs text-hacker-dim leading-relaxed border-t border-hacker-border pt-3">{item.a}</div>
          </details>
        ))}
      </div>
    </section>

    <!-- COMPARE -->
    <section class="space-y-6">
      <div class="text-xs text-hacker-dim">// COMPARE_WITH_OTHER_PARTS</div>
      <h2 class="text-xl font-bold text-hacker-text">C1 Part 4 vs B2 Part 4 — the structural differences</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-xs font-mono border-collapse">
          <thead>
            <tr class="border-b border-hacker-border">
              <th class="text-left py-3 pr-4 text-hacker-green font-bold">Feature</th>
              <th class="text-left py-3 pr-4 text-hacker-dim font-normal">B2 First</th>
              <th class="text-left py-3 text-hacker-green font-normal">C1 Advanced</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['Questions', '6', '6'],
              ['Marks', '12 (2 per Q)', '12 (2 per Q)'],
              ['Word limit', '2–5 words', '3–8 words'],
              ['Inversion', 'Not tested', 'Frequently tested'],
              ['Cleft sentences', 'Not tested', 'Regularly tested'],
              ['Inverted conditionals', 'Not tested', 'Tested'],
              ['Passive reporting', 'Basic', 'Perfect passive infinitive'],
              ['Nominalisation', 'Occasional', 'Regular'],
            ].map(([feature, b2, c1]) => (
              <tr class="border-b border-hacker-border">
                <td class="py-3 pr-4 font-bold text-hacker-text">{feature}</td>
                <td class="py-3 pr-4 text-hacker-dim">{b2}</td>
                <td class="py-3 text-hacker-green font-bold">{c1}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- CTA -->
    <section class="border border-hacker-green p-6 space-y-5">
      <div class="text-xs text-hacker-dim">// NEXT_STEPS</div>
