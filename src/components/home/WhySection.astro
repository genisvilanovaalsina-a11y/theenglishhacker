---
const reasons = [
  {
    tag: '// 01',
    title: 'Real Cambridge format',
    body: 'No simplified exercises. No watered-down content. Every question follows the exact same format you\'ll face on exam day — because that\'s the only kind of practice that counts.',
  },
  {
    tag: '// 02',
    title: 'Track your progress',
    body: 'Your score history lives in your browser. See exactly where you\'re losing points — reading, grammar, vocabulary — and target your weak spots before the exam.',
  },
  {
    tag: '// 03',
    title: 'Built for speed',
    body: 'No login required. No slow loading. No ads. Open it on the bus, practice for 10 minutes, close it. That\'s it. Your progress is saved automatically.',
  },
];
---

<section class="px-6 py-16 max-w-5xl mx-auto border-t border-hacker-border">
  <div class="text-xs text-hacker-dim mb-10">
    <span class="text-hacker-green">// WHY_THE_ENGLISH_HACKER</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {reasons.map((r) => (
      <div class="space-y-3">
        <div class="text-xs text-hacker-dim">{r.tag}</div>
        <h3 class="font-bold text-hacker-text text-sm">{r.title}</h3>
        <p class="text-xs text-hacker-dim leading-relaxed">{r.body}</p>
      </div>
    ))}
  </div>
</section>
