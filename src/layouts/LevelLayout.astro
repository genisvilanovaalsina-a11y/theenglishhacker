---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  level: string;
  levelLabel: string;
  exerciseType?: string;
}

const {
  title,
  description,
  level,
  levelLabel,
  exerciseType = 'CLOZE_TEST',
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <header class="border-b border-hacker-border px-4 py-3 text-xs text-hacker-dim overflow-x-auto">
    <div class="flex items-center gap-6 min-w-max">
      <a href="/" class="text-hacker-green hover:text-hacker-green-dim transition-colors">&gt;_ TheEnglishHacker</a>
      <span>[ LEVEL: <span class="text-hacker-text">{level}</span> ]</span>
      <span>[ TYPE: <span class="text-hacker-text">{exerciseType}</span> ]</span>
      <span>[ STATUS: <span class="text-hacker-amber">DEMO</span> ]</span>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="border-t border-hacker-border px-6 py-6 mt-16 text-xs text-hacker-dim">
    <div class="max-w-4xl mx-auto flex flex-wrap justify-between gap-4">
      <span>&copy; {new Date().getFullYear()} TheEnglishHacker.com</span>
      <div class="flex gap-6">
        <a href="/privacy" class="hover:text-hacker-green transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-hacker-green transition-colors">Terms</a>
        <a href="/cookies" class="hover:text-hacker-green transition-colors">Cookies</a>
      </div>
    </div>
  </footer>
</BaseLayout>
